# ---------------- LLM -------------------------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # optional: OpenRouter/Groq/etc (OpenAI-compatible)
OPENAI_MODEL=gpt-5.2
# V5: 0.3 (your ask — mild variance for liveliness). NOTE: gpt-5.x reasoning
# models are API-fixed at default temperature (the code silently omits it for
# gpt-5*); set OPENAI_MODEL=gpt-4.1 to make 0.3 actually apply.
OPENAI_TEMPERATURE=0.3

# ---------------- RAG knowledge bases (pgvector) ---------------------------
RAG_MODE=auto                   # auto (pgvector when indexed, inline fallback) | rag | inline
DATABASE_URL=postgresql://diallux:diallux@localhost:5432/diallux
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3                     # the DEPLOYED Retell kb_config.top_k
RAG_CHAR_BUDGET=1600
# build the index once: python scripts/rag_ingest.py

# ---------------- Deepgram STT -------------------------------------------------
DEEPGRAM_API_KEY=...
DEEPGRAM_MODE=flux              # flux (conversational, native end-of-turn) | nova3
DEEPGRAM_MODEL=flux-general-en  # nova-3 when DEEPGRAM_MODE=nova3

DEEPGRAM_EOT_THRESHOLD=0.65
DEEPGRAM_EOT_TIMEOUT_MS=3000
DEEPGRAM_EAGER_EOT_THRESHOLD=0.35   # iter91 pack (code default; < EOT 0.65 = Deepgram OK)

# ---------------- TTS provider ------------------------------------------------
TTS_PROVIDER=cartesia           # cartesia | elevenlabs

# speech normalization (the Retell-native layer): numbers/codes read slowly
TTS_NORMALIZE=true
TTS_PHONE_STYLE=digits          # digits | natural | spell (cartesia only)

# V5: per-state delivery profiles — the graph state controls emotion/speed
# (diallux/media/delivery.py: one row per state; profile fields win over the
# .env globals below; false = .env globals only, exact V4 behavior)
TTS_DELIVERY_PROFILES=false   # owner 2026-10-05: EL = pure prod globals; per-state EL rows in delivery.py = Cartesia-era (inert)

# ---------------- Cartesia ------------------------------------------------
CARTESIA_API_KEY=...
CARTESIA_MODEL_ID=sonic-3.6-2026-08-27
CARTESIA_VOICE_ID=829ccd10-f8b3-43cd-b8a0-4aeaa81f3b30   # Linda (proven live iter21 2026-09-06; backups: Jacqueline 9626c31c-bec5-4cca-baa8-f8ba9e84c8bc, Laureen a33f7a4c-100f-41cf-a1fd-5822e8fc253f, Jessica 25d7abcb-4d6d-4aca-adce-8a1c85620c8b)
CARTESIA_LANGUAGE=en
CARTESIA_BUFFERING=custom       # custom (our sentence gate) | managed (Cartesia buffers)
CARTESIA_MAX_BUFFER_DELAY_MS=0
# generation_config per request (docs: guidance; emotion English-only beta;
# best on emotive-tagged voices). BASE tuning lives HERE, not in the prompt;
# V5 delivery profiles merge over these per state (profile wins):
CARTESIA_SPEED=1.05                # proven Linda cadence (iter21 live session)
# CARTESIA_VOLUME=1.0           # 0.5-2.0
# CARTESIA_EMOTION=calm         # e.g. calm | trust | happy | curiosity

# ---------------- ElevenLabs (optional provider) ---------------------------
# BASE tuning (V5 delivery profiles merge over these per state; profile wins)
#
# PROD VOICE CONFIG (owner-approved ear test 2026-09-22, voice trials in
# research/surgeon/iter66-elevenlabs-cutover/VOICE_IDS.md):
#   voice "Sarah - Casual & Modern" uG1JFy6xppqckhHCs2KG, eleven_turbo_v2_5,
#   speed 1.06, stability 0.5, style 1.0, speaker boost on.
# NOTE: EL removed the old default voices (Feb 2026 purge); legacy ids remap on
# post-March-2026 accounts. ELEVENLABS_LATENCY_OPT is gone (deprecated param,
# removed) — the ws inactivity timeout is ELEVENLABS_INACTIVITY_TIMEOUT (max 180).
#
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=uG1JFy6xppqckhHCs2KG
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_INACTIVITY_TIMEOUT=180
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=1.0
# ELEVENLABS_SPEED=1.06         # 0.7-1.2

# ---------------- Telephony -----------------------------------------------------
PUBLIC_BASE_URL=wss://calls.your-domain.com
# provisioning script only:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------- Webhook tools (Retell HMAC contract, verbatim) ---------------
RETELL_API_KEY=key_...          # same key your slots.diallux-ai.site services accept

# ---------------- Langfuse (self-hosted) ---------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ---------------- V2 production ------------------------------------------------
LANGGRAPH_CHECKPOINT=memory     # memory | postgres
# DATABASE_URL=                 # shared with RAG above when postgres
METRICS_ENABLED=true
HANGUP_MODE=mark                # mark (playback-confirmed) | timer
# V3: LLM writes TTS-friendly text (Cartesia voice-agent rules; normalizer backs it)
TTS_VOICE_RULES=true

# ---------------- Runtime --------------------------------------------------------
HTTP_PORT=8000
LOG_LEVEL=info
# iter38 F3 (PT-34): hard cap on real graph turns per call — graceful close at
# the cap (checked between turns; a mid-flight booking always finishes).
MAX_CALL_TURNS=64

# ---- Audio transport (iter21 browser-mic bridge) ----
# twilio = Media Streams 8k mulaw | browser = /mic ws, 16-bit PCM 16 kHz mono
AUDIO_TRANSPORT=browser   # the proven bridge session (Chrome -> /mic)
BROWSER_SAMPLE_RATE=16000
